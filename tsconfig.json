{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "vite-plugin-pwa/client", "node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "tests", "server", "db", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts"]
}
